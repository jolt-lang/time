;; tick provides the idiomatic Clojure time API on top of the java.time.* shim in
;; src/. tick's own transitive deps — cljc.java-time and time-literals — resolve
;; from Maven automatically (jolt fetches the source from the JAR). time-literals
;; is still vendored: its #time data-readers use the (. Class parse) dot-form,
;; which jolt doesn't yet compile (jolt-5hnv), so the vendored copy carries the
;; equivalent slash-form; being on :paths it shadows the Maven one.
{:paths ["src" "vendor/time-literals"]

 ;; The java.time classes jolt.time installs that core does NOT carry (RFC 0008:
 ;; core has the value types, this library has everything that formats or names a
 ;; zone), plus java.util.Locale. Declaring them (RFC 0014) is what lets a project
 ;; that depends on this library write ZoneId or DateTimeFormatter — or require
 ;; tick.core, whose cljc.java-time namespaces resolve these as they load —
 ;; without knowing the jolt.time install namespace.
 ;;
 ;; Fully-qualified only: jolt derives the simple spelling. The runtime used to
 ;; carry both by hand, and DateTimeFormatterBuilder missing from the simple form
 ;; is what kept malli's transform.cljc from loading while the qualified spelling
 ;; worked.
 :jolt/provides {jolt.time ["java.time.format.DateTimeFormatter"
                            "java.time.format.DateTimeFormatterBuilder"
                            "java.time.format.FormatStyle"
                            "java.time.ZoneOffset"
                            "java.time.ZoneId"
                            "java.time.ZonedDateTime"
                            "java.time.OffsetDateTime"
                            "java.time.OffsetTime"
                            "java.time.Clock"
                            "java.util.Locale"]}

 :deps {io.github.juxt/tick
        {:git/url "https://github.com/juxt/tick.git"
         :git/sha "3c2cc4e809c21476f63470cd3e5cb2ff8fa5ef69"}}

 :aliases
 {:test {:extra-paths ["test" "vendor/tick-test" "vendor/spec-alpha"]
         :main-opts ["-m" "jolt.time-test-runner"]}

  :stage {:extra-paths ["test"]
          :main-opts ["-m" "jolt.time.stage-test"]}}

 :tasks {test "jolt -M:test"}}
